rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'ankit599patel@gmail.com' && request.auth.token.email_verified == true; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /profiles/{uid}  { allow read, write: if isSelf(uid) || isAdmin(); }
    match /requests/{uid}  { allow read, write: if isSelf(uid) || isAdmin(); }
    match /access/{uid}    { allow read: if isSelf(uid) || isAdmin(); allow write: if isAdmin(); }
    match /inquiries/{id}  { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /certs/{no}      { allow read: if true; allow write: if isAdmin(); }
    match /config/{d}      { allow read: if true; allow write: if isAdmin(); }
  }
}
